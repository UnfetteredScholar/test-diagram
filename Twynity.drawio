        <mxCell id="_hYA65MoutoxuMAghtsv-31" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Client Credentials auth provides services with access tokens to call protected endpoints without relying on user tokens&lt;div&gt;.&lt;div&gt;Purpose:&lt;/div&gt;&lt;div&gt;1. These tokens have higher permissions than user role tokens.&lt;/div&gt;&lt;div&gt;2. Resources created with these tokens belong and are managed solely by the client (eg. Storing a file as a client allows the client to control access, updates and deletion)&lt;/div&gt;&lt;div&gt;3. Avoids unnecessary creation of user accounts.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="348" x="1511" y="360" as="geometry" />
        </mxCell>
